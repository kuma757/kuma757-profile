---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'kuma757 | Discord Bot 開発者 / Web 開発者';
const pageDescription =
  'kuma757 のプロフィール。Discord Bot や Web サービスの開発・運用を行っています。Discord 読み上げ Bot「SimpliesBot TTS」と Minecraft 国家 RP サーバー「KumaEarth」を開発・運営しています。';

const DISCORD_URL = 'https://discord.com/users/1125045664821289030';
const X_URL = 'https://x.com/kuma757_dev';
const KUMAEARTH_URL = 'https://kumaearth.net/';
const SIMPLIES_URL = 'https://tts.simpliesbot.kuma757.dev/';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- JSON-LD 構造化データ -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "kuma757",
      "alternateName": "kuma757_dev",
      "description": "Discord Bot と Web サービスの開発・運用を行っている開発者。SimpliesBot TTS と KumaEarth を開発・運営。",
      "sameAs": [
        "https://x.com/kuma757_dev",
        "https://discord.com/users/1125045664821289030",
        "https://kuma757.dev",
        "https://tts.simpliesbot.kuma757.dev/"
      ]
    }
  </script>

  <!-- ヒーロー -->
  <section class="hero" id="top">
    <div class="container hero-inner">
      <h1>kuma757</h1>
      <p class="hero-desc">
        Discord Bot や Web サービスの開発・運用をしています。<strong>Discord 読み上げ Bot「SimpliesBot
        TTS」</strong>と、<strong>Minecraft 国家 RP サーバー「KumaEarth」</strong>を個人で開発・運営しています。
        作るだけでなく、動かし続けるところまでを大切にしています。
      </p>
      <div class="hero-actions">
        <a href={X_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">X をフォロー</a>
        <a href="#projects" class="btn btn-secondary">プロジェクトを見る</a>
      </div>
      <div class="hero-links">
        <a href={SIMPLIES_URL} target="_blank" rel="noopener noreferrer">SimpliesBot TTS</a>
        <a href={KUMAEARTH_URL} target="_blank" rel="noopener noreferrer">KumaEarth</a>
        <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Discord</a>
      </div>
    </div>
  </section>

  <!-- プロフィール -->
  <section class="section section--soft" id="profile">
    <div class="container">
      <div class="section-head">
        <h2>プロフィール</h2>
        <p>
          個人でサービスを作り、開発から運用まで一貫して行っています。Discord Bot と Web
          サービスが主な活動です。
        </p>
      </div>
      <hr class="rule" />

      <dl class="facts">
        <div>
          <dt>名前</dt>
          <dd>kuma757</dd>
        </div>
        <div>
          <dt>活動</dt>
          <dd>Discord Bot / Web</dd>
        </div>
        <div>
          <dt>プロジェクト</dt>
          <dd>2</dd>
        </div>
        <div>
          <dt>連絡先</dt>
          <dd>
            <a href={X_URL} target="_blank" rel="noopener noreferrer">X</a>
            <span aria-hidden="true"> / </span>
            <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Discord</a>
          </dd>
        </div>
      </dl>

      <p class="note">
        <a href={KUMAEARTH_URL} target="_blank" rel="noopener noreferrer">kumaearth.net</a>
        <span class="dot" aria-hidden="true">·</span>
        <a href={SIMPLIES_URL} target="_blank" rel="noopener noreferrer">tts.simpliesbot.kuma757.dev</a>
      </p>
    </div>
  </section>

  <!-- プロジェクト -->
  <section class="section" id="projects">
    <div class="container">
      <div class="section-head">
        <h2>プロジェクト</h2>
        <p>開発・運営しているプロジェクトです。どちらも個人で開発・運用しています。</p>
      </div>
      <hr class="rule" />

      <div class="projects">
        <a href={KUMAEARTH_URL} target="_blank" rel="noopener noreferrer" class="project-tile">
          <h3>KumaEarth</h3>
          <p class="project-desc">
            地球を舞台にしたプレイヤー主導の国家 RP サーバー。Java・統合版クロスプレイに対応し、プレイヤーたちが国家を作り、世界を動かしていきます。
          </p>
          <p class="project-meta">Minecraft · Java / 統合版 · 国家 RP</p>
          <p class="project-url">kumaearth.net</p>
        </a>

        <a href={SIMPLIES_URL} target="_blank" rel="noopener noreferrer" class="project-tile">
          <h3>SimpliesBot TTS</h3>
          <p class="project-desc">
            接続中のボイスチャンネルへ、テキストチャンネルの投稿を音声で届ける Discord Bot。VOICEVOX・OpenJTalk
            の話者、個人辞書・サーバー辞書、オートコネクトに対応しています。
          </p>
          <p class="project-meta">Discord Bot · 読み上げ · VOICEVOX</p>
          <p class="project-url">tts.simpliesbot.kuma757.dev</p>
        </a>
      </div>
    </div>
  </section>

  <!-- リンク -->
  <section class="section section--soft" id="links">
    <div class="container">
      <div class="section-head">
        <h2>リンク</h2>
        <p>連絡やフォローは X まで。kuma757 の名前で各サービスを公開しています。</p>
      </div>
      <hr class="rule" />

      <div class="links">
        <a href={X_URL} target="_blank" rel="noopener noreferrer" class="link-tile">
          <span class="link-label">X（旧 Twitter）</span>
          <span class="link-meta">@kuma757_dev</span>
        </a>

        <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="link-tile">
          <span class="link-label">Discord</span>
          <span class="link-meta">kuma757</span>
        </a>

        <a href={KUMAEARTH_URL} target="_blank" rel="noopener noreferrer" class="link-tile">
          <span class="link-label">KumaEarth</span>
          <span class="link-meta">kumaearth.net</span>
        </a>

        <a href={SIMPLIES_URL} target="_blank" rel="noopener noreferrer" class="link-tile">
          <span class="link-label">SimpliesBot TTS</span>
          <span class="link-meta">tts.simpliesbot.kuma757.dev</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
