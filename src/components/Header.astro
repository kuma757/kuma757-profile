---
// ヘッダー（スティッキー / モバイルメニュー付き）
// 開閉動作は BaseLayout のスクリプトが data 属性経由で制御する
---

<header class="site-header">
  <div class="container header-inner">
    <a href="#top" class="brand" aria-label="kuma757 トップへ">
      <img src="/favicon.svg" alt="kuma757" width="28" height="28" class="brand-icon" />
      <span>kuma757</span>
    </a>

    <!-- デスクトップナビゲーション -->
    <nav class="nav-desktop" aria-label="メインナビゲーション">
      <a href="#top">ホーム</a>
      <a href="#profile">プロフィール</a>
      <a href="#projects">プロジェクト</a>
      <a href="#links">リンク</a>
      <a href="https://x.com/kuma757_dev" target="_blank" rel="noopener noreferrer" class="nav-cta">X をフォロー</a>
    </nav>

    <!-- モバイルメニュートグル -->
    <button
      type="button"
      class="menu-toggle"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="メニューを開く"
      data-menu-toggle
    >
      <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <!-- モバイルメニュー -->
  <div id="mobile-menu" class="mobile-menu" data-menu hidden>
    <nav class="container mobile-nav" aria-label="モバイルナビゲーション">
      <a href="#top">ホーム</a>
      <a href="#profile">プロフィール</a>
      <a href="#projects">プロジェクト</a>
      <a href="#links">リンク</a>
      <a href="https://x.com/kuma757_dev" target="_blank" rel="noopener noreferrer" class="mobile-cta">X をフォロー</a>
    </nav>
  </div>
</header>